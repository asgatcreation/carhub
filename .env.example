# Copy to `.env` and fill in. Everything here is optional for local development
# except DJANGO_DEBUG=True (or a DJANGO_SECRET_KEY when DEBUG is off).

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, needed behind HTTPS in production, e.g. https://carhub.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Postgres in production, e.g. postgres://user:password@host:5432/carhub (SQLite when empty)
DATABASE_URL=

# Paystack test keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Record orders without a payment provider (labelled as demo orders)
DEMO_CHECKOUT=True
# Show one-click demo accounts on the sign-in page
SHOW_DEMO_LOGINS=True

# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Redis for multi-process WebSocket chat (in-memory otherwise)
REDIS_URL=

# Optional SMTP (console backend when empty)
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Set to True when running under daphne/uvicorn (WebSocket chat)
CHAT_WEBSOCKETS=False
